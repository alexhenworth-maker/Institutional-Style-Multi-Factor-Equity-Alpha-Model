"date\")[factor]\n","        .transform(\n","            lambda x: pd.qcut(\n","                x.rank(method=\"first\"),\n","                5,\n","                labels=False\n","            ) + 1\n","        )\n","    )\n","\n","    result = (\n","        temp\n","        .groupby(\n","            [\"date\", \"quintile\"]\n","        )[\"forward_return\"]\n","        .mean()\n","        .unstack()\n","    )\n","\n","    return result\n","\n","\n","momentum_quintiles = factor_quintile_returns(\n","    dataset,\n","    \"factor_momentum\"\n",")\n","\n","cumulative = (\n","    1 + momentum_quintiles\n",").cumprod()\n","\n","plt.figure(\n","    figsize=(14, 7)\n",")\n","\n","for column in cumulative.columns:\n","\n","    plt.plot(\n","        cumulative.index,\n","        cumulative[column],\n","        label=f\"Q{column}\"\n","    )\n","\n","plt.title(\n","    \"Momentum Factor — Quintile Performance\",\n","    fontsize=15,\n","    fontweight=\"bold\"\n",")\n","\n","plt.ylabel(\"Growth of $1\")\n","plt.legend()\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    CHART_DIR / \"momentum_quintiles.png\",\n","    dpi=200,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","# ============================================================\n","# CELL 24 — INFORMATION COEFFICIENT DASHBOARD\n","# ============================================================\n","\n","fig, axes = plt.subplots(\n","    2,\n","    1,\n","    figsize=(14, 9)\n",")\n","\n","\n","rolling_ic = ic_series.rolling(\n","    63\n",").mean()\n","\n","axes[0].plot(\n","    rolling_ic.index,\n","    rolling_ic,\n","    linewidth=2\n",")\n","\n","axes[0].axhline(\n","    0,\n","    linestyle=\"--\",\n","    linewidth=1\n",")\n","\n","axes[0].set_title(\n","    \"63-Day Rolling Information Coefficient\",\n","    fontsize=14,\n","    fontweight=\"bold\"\n",")\n","\n","axes[0].set_ylabel(\"IC\")\n","\n","\n","axes[1].hist(\n","    ic_series.dropna(),\n","    bins=30\n",")\n","\n","axes[1].axvli