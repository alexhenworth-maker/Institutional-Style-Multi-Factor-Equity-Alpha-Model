n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"alpha_percentile\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.34253953543107013,\n        \"min\": 0.1,\n        \"max\": 1.0,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          0.2,\n          0.95,\n          0.3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"weight\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.10540925533894599,\n        \"min\": 0.0,\n        \"max\": 0.2,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          0.0,\n          0.2\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Research complete.\n"]}],"source":["# ============================================================\n","# CELL 1 — PROJECT SETUP\n","# Institutional Multi-Factor Equity Alpha Model\n","# ============================================================\n","\n","!pip -q install yfinance pandas numpy scipy statsmodels \\\n","    scikit-learn requests pyarrow plotly seaborn joblib\n","\n","import os\n","import time\n","import json\n","import math\n","import warnings\n","from pathlib import Path\n","from dataclasses import dataclass\n","from typing import Dict, List, Optional, Tuple\n","\n","import numpy as np\n","import pandas as pd\n","import requests\n","import yfinance as yf\n","\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import plotly.express as px\n","import plotly.graph_objects as go\n","\n","from scipy.stats import zscore, spearmanr\n","from sklearn.linear_model import LinearRegression\n","from sklearn.covariance import LedoitWolf\n","\n","warnings.filterwarnings(\"ignore\")\n","\n","PROJECT_ROOT = Path(\"/content/multi_factor_equity_alpha\")\n","\n","DATA_DIR = PROJECT_ROOT / \"data\"\n","RAW_DIR = DATA_DIR / \"raw\"\n","PROCESSED_DIR = DATA_DIR / \"processed\"\n","CACHE_DIR = DATA_DIR / \"cache\"\n","\n","OUTPUT_DIR = PROJECT_ROOT / \"outputs\"\n","CHART_DIR = OUTPUT_DIR / \"charts\"\n","TABLE_DIR = OUTPUT_DIR / \"tables\"\n","\n","for directory in [\n","    RAW_DIR,\n","    PROCESSED_DIR,\n","    CACHE_DIR,\n","    CHART_DIR,\n","    TABLE_DIR\n","]:\n","    directory.mkdir(parents=True, exist_ok=True)\n","\n","print(f\"Project directory: {PROJECT_ROOT}\")\n","# ============================================================\n","# CELL 2 — CONFIGURATION\n","# ============================================================\n","\n","@dataclass\n","class Config:\n","    start_date: str = \"2015-01-01\"\n","    end_date: str = \"2025-12-31\"\n","\n","    rebalance_frequency: str = \"ME\"\n","\n","    top_quantile: float = 0.20\n","\n","    transaction_cost_bps: float = 10.0\n","\n","    winsor_lower: float = 0.01\n","    winsor_upper: float = 0.99\n","\n","    min_history_days: int = 252\n","\n","    sec_delay_seconds: float = 0.15\n","\n","\n","    sec_user_agent: str = \"QuantResearch student@example.com\"\n","\n","\n","CONFIG = Config()\n","\n","TICKERS = [\n","    \"AAPL\", \"MSFT\", \"AMZN\", \"GOOGL\", \"META\",\n","    \"NVDA\", \"JPM\", \"JNJ\", \"PG\", \"XOM\",\n","    \"UNH\", \"HD\", \"MA\", \"V\", \"KO\",\n","    \"PEP\", \"COST\", \"WMT\", \"CAT\", \"IBM\"\n","]\n","\n","FACTOR_WEIGHTS = {\n","    \"momentum\": 0.25,\n","    \"value\": 0.20,\n","    \"quality\": 0.20,\n","    \"growth\": 0.15,\n","    \"low_vol\": 0.10,\n","    \"size\": 0.10,\n","}\n","\n","print(\"Universe:\", len(TICKERS))\n","print(\"Factor weights:\", FACTOR_WEIGHTS)\n","\n","\n","# ============================================================\n","# CELL 3 — SEC EDGAR CLIENT\n","# ============================================================\n","\n","class SECClient:\n","    \"\"\"\n","    Lightweight SEC Company Facts client.\n","\n","    Design goals:\n","        - Respect SEC request identification requirements.\n","        - Cache responses locally.\n","        - Handle transient failures.\n","        - Avoid repeatedly downloading identical data.\n","    \"\"\"\n","\n","    BASE_URL = \"https://data.sec.gov\"\n","\n","    def __init__(self, user_agent: str):\n","        self.session = requests.Session()\n","\n","        self.session.headers.update({\n","            \"User-Agent\": user_agent,\n","            \"Accept-Encoding\": \"gzip, deflate\",\n","            \"Host\": \"data.sec.gov\"\n","        })\n","\n","        self.cache_dir = CACHE_DIR / \"sec\"\n","        self.cache_dir.mkdir(parents=True, exist_ok=True)\n","\n","    def _request_json(\n","        self,\n","        url: str,\n","        cache_name: str,\n","        retries: int = 3\n","    ) -> dict:\n","\n","        cache_path = self.cache_dir / cache_name\n","\n","\n","\n","        if cache_path.exists():\n","            try:\n","                with open(cache_path, \"r\") as f:\n","                    return json.load(f)\n","            except Exception:\n","                pass\n","\n","\n","        for attempt in range(retries):\n","\n","            try:\n","                response = self.session.get(\n","                    url,\n","                    timeout=30\n","                )\n","\n","                if response.status_code == 200:\n","\n","                    data = response.json()\n","\n","                    with open(cache_path, \"w\") as f:\n","                        json.dump(data, f)\n","\n","                    time.sleep(CONFIG.sec_delay_seconds)\n","\n","                    return data\n","\n","                elif response.status_code == 429:\n","\n","                    wait = 2 ** attempt\n","                    print(\n","                        f\"SEC rate limit encountered. \"\n","                        f\"Waiting {wait}s...\"\n","                    )\n","                    time.sleep(wait)\n","\n","                else:\n","\n","                    print(\n","                        f\"SEC request failed: \"\n","                        f\"{response.status_code}\"\n","                    )\n","\n","            except requests.RequestException as exc:\n","\n","                print(\n","                    f\"SEC request error: {exc}\"\n","                )\n","\n","                time.sleep(2 ** attempt)\n","\n","        raise RuntimeError(\n","            f\"Unable to retrieve SEC data: {url}\"\n","        )\n","\n","    def company_facts(self, cik: str) -> dict:\n","\n","        cik = str(cik).zfill(10)\n","\n","        url = (\n","            f\"{self.BASE_URL}/api/xbrl/\"\n","            f\"companyfacts/CIK{cik}.json\"\n","        )\n","\n","        return self._request_json(\n","            url=url,\n","            cache_name=f\"{cik}_companyfacts.json\"\n","        )\n","\n","\n","sec = SECClient(CONFIG.sec_user_agent)\n","\n","print(\"SEC client initialized.\")\n","# ============================================================\n","# CELL 4 — SEC TICKER → CIK MAPPING\n","# ============================================================\n","\n","def get_sec_ticker_map() -> pd.DataFrame:\n","    \"\"\"\n","    Download SEC's public ticker/CIK mapping.\n","    \"\"\"\n","\n","    url = \"https://www.sec.gov/files/company_tickers.json\"\n","\n","    headers = {\n","        \"User-Agent\": CONFIG.sec_user_agent\n","    }\n","\n","    response = requests.get(\n","        url,\n","        headers=headers,\n","        timeout=30\n","    )\n","\n","    response.raise_for_status()\n","\n","    raw = response.json()\n","\n","    rows = []\n","\n","    for item in raw.values():\n","\n","        rows.append({\n","            \"ticker\": item[\"ticker\"].upper(),\n","            \"cik\": str(item[\"cik_str\"]).zfill(10),\n","            \"company\": item[\"title\"]\n","        })\n","\n","    return pd.DataFrame(rows)\n","\n","\n","sec_tickers = get_sec_ticker_map()\n","\n","ticker_map = (\n","    sec_tickers\n","    .drop_duplicates(\"ticker\")\n","    .set_index(\"ticker\")\n",")\n","\n","ticker_map.head()\n","# ============================================================\n","# CELL 5 — MARKET DATA DOWNLOAD\n","# ============================================================\n","\n","def download_market_data(\n","    tickers: List[str],\n","    start: str,\n","    end: str\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Download adjusted historical prices.\n","\n","    MultiIndex output from yfinance is converted into\n","    long format for easier factor engineering.\n","    \"\"\"\n","\n","    try:\n","\n","        data = yf.download(\n","            tickers=tickers,\n","            start=start,\n","            end=end,\n","            auto_adjust=True,\n","            progress=False,\n","            group_by=\"column\",\n","            threads=True\n","        )\n","\n","    except Exception as exc:\n","\n","        raise RuntimeError(\n","            f\"Yahoo Finance download failed: {exc}\"\n","        )\n","\n","    if data.empty:\n","        raise ValueError(\n","            \"No market data returned.\"\n","        )\n","\n","\n","\n","    if isinstance(data.columns, pd.MultiIndex):\n","\n","        close = data[\"Close\"].copy()\n","\n","    else:\n","\n","        close = data[[\"Close\"]].copy()\n","        close.columns = [tickers[0]]\n","\n","    close = (\n","        close\n","        .replace([np.inf, -np.inf], np.nan)\n","        .sort_index()\n","    )\n","\n","    return close\n","\n","\n","prices = download_market_data(\n","    TICKERS,\n","    CONFIG.start_date,\n","    CONFIG.end_date\n",")\n","\n","print(prices.shape)\n","prices.tail()\n","\n","\n","# ============================================================\n","# CELL 6 — SEC FUNDAMENTAL DATA EXTRACTION\n","# ============================================================\n","\n","SEC_TAGS = {\n","    \"revenue\": [\n","        \"RevenueFromContractWithCustomerExcludingAssessedTax\",\n","        \"Revenues\"\n","    ],\n","\n","    \"net_income\": [\n","        \"NetIncomeLoss\"\n","    ],\n","\n","    \"assets\": [\n","        \"Assets\"\n","    ],\n","\n","    \"equity\": [\n","        \"StockholdersEquity\",\n","        \"StockholdersEquityIncludingPortionAttributableToNoncontrollingInterest\"\n","    ],\n","\n","    \"operating_income\": [\n","        \"OperatingIncomeLoss\"\n","    ],\n","\n","    \"cash\": [\n","        \"CashAndCashEquivalentsAtCarryingValue\"\n","    ],\n","\n","    \"shares\": [\n","        \"EntityCommonStockSharesOutstanding\"\n","    ]\n","}\n","\n","\n","def extract_sec_concept(\n","    facts: dict,\n","    concept_names: List[str],\n","    ticker: str\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Extract the first available SEC XBRL concept.\n","\n","    Each observation retains:\n","        - period end\n","        - filing date\n","        - value\n","        - form\n","        - fiscal period\n","        - fiscal year\n","    \"\"\"\n","\n","    facts_root = facts.get(\"facts\", {})\n","\n","\n","    namespaces = [\"us-gaap\", \"dei\"]\n","\n","    for namespace in namespaces:\n","\n","        namespace_data = facts_root.get(namespace, {})\n","\n","        for concept in concept_names:\n","\n","            if concept not in namespace_data:\n","                continue\n","\n","            concept_data = namespace_data[concept]\n","\n","            units = concept_data.get(\"units\", {})\n","\n","\n","            unit_name = (\n","                \"USD\"\n","                if \"USD\" in units\n","                else next(iter(units), None)\n","            )\n","\n","            if unit_name is None:\n","                continue\n","\n","            observations = units[unit_name]\n","\n","            records = []\n","\n","            for obs in observations:\n","\n","                if \"val\" not in obs:\n","                    continue\n","\n","                records.append({\n","                    \"ticker\": ticker,\n","                    \"concept\": concept,\n","                    \"value\": obs.get(\"val\"),\n","                    \"unit\": unit_name,\n","                    \"start\": obs.get(\"start\"),\n","                    \"end\": obs.get(\"end\"),\n","                    \"filed\": obs.get(\"filed\"),\n","                    \"form\": obs.get(\"form\"),\n","                    \"fp\": obs.get(\"fp\"),\n","                    \"fy\": obs.get(\"fy\"),\n","                    \"frame\": obs.get(\"frame\")\n","                })\n","\n","            if records:\n","                return pd.DataFrame(records)\n","\n","    return pd.DataFrame()\n","\n","\n","def download_fundamentals(\n","    tickers: List[str]\n",") -> pd.DataFrame:\n","\n","    all_records = []\n","\n","    for ticker in tickers:\n","\n","        try:\n","\n","            if ticker not in ticker_map.index:\n","                print(f\"{ticker}: no SEC CIK mapping.\")\n","                continue\n","\n","            cik = ticker_map.loc[ticker, \"cik\"]\n","\n","            facts = sec.company_facts(cik)\n","\n","            for factor_name, tags in SEC_TAGS.items():\n","\n","                df = extract_sec_concept(\n","                    facts,\n","                    tags,\n","                    ticker\n","                )\n","\n","                if df.empty:\n","                    continue\n","\n","                df[\"fundamental\"] = factor_name\n","\n","                all_records.append(df)\n","\n","        except Exception as exc:\n","\n","            print(\n","                f\"Fundamental download failed \"\n","                f\"for {ticker}: {exc}\"\n","            )\n","\n","    if not all_records:\n","        raise RuntimeError(\n","            \"No SEC fundamental data retrieved.\"\n","        )\n","\n","    fundamentals = pd.concat(\n","        all_records,\n","        ignore_index=True\n","    )\n","\n","    fundamentals[\"filed\"] = pd.to_datetime(\n","        fundamentals[\"filed\"],\n","        errors=\"coerce\"\n","    )\n","\n","    fundamentals[\"end\"] = pd.to_datetime(\n","        fundamentals[\"end\"],\n","        errors=\"coerce\"\n","    )\n","\n","    fundamentals[\"value\"] = pd.to_numeric(\n","        fundamentals[\"value\"],\n","        errors=\"coerce\"\n","    )\n","\n","    fundamentals = (\n","        fundamentals\n","        .dropna(subset=[\"filed\", \"value\"])\n","        .sort_values([\"ticker\", \"fundamental\", \"filed\"])\n","    )\n","\n","    return fundamentals\n","\n","\n","fundamentals = download_fundamentals(TICKERS)\n","\n","print(fundamentals.shape)\n","fundamentals.head()\n","\n","\n","\n","# ============================================================\n","# CELL 7 — POINT-IN-TIME FUNDAMENTAL ENGINE\n","# ============================================================\n","\n","def point_in_time_fundamentals(\n","    fundamentals: pd.DataFrame,\n","    rebalance_dates: pd.DatetimeIndex\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Build a point-in-time fundamental panel.\n","\n","    For every rebalance date, only information with:\n","\n","        filing_date <= rebalance_date\n","\n","    is eligible.\n","\n","    When multiple observations exist, the most recently\n","    filed observation is selected.\n","\n","    This is critical for avoiding look-ahead bias.\n","    \"\"\"\n","\n","    output = []\n","\n","    fundamentals = fundamentals.copy()\n","\n","    fundamentals = fundamentals.sort_values(\n","        [\"ticker\", \"fundamental\", \"filed\"]\n","    )\n","\n","    for rebalance_date in rebalance_dates:\n","\n","        available = fundamentals[\n","            fundamentals[\"filed\"] <= rebalance_date\n","        ]\n","\n","        if available.empty:\n","            continue\n","\n","        latest = (\n","            available\n","            .sort_values(\"filed\")\n","            .groupby(\n","                [\"ticker\", \"fundamental\"],\n","                as_index=False\n","            )\n","            .tail(1)\n","        )\n","\n","        latest = latest.copy()\n","\n","        latest[\"date\"] = rebalance_date\n","\n","        output.append(latest)\n","\n","    if not output:\n","        return pd.DataFrame()\n","\n","    return pd.concat(\n","        output,\n","        ignore_index=True\n","    )\n","\n","\n","rebalance_dates = prices.resample(\n","    CONFIG.rebalance_frequency\n",").last().index\n","\n","pit_fundamentals = point_in_time_fundamentals(\n","    fundamentals,\n","    rebalance_dates\n",")\n","\n","print(pit_fundamentals.shape)\n","# ============================================================\n","# CELL 8 — WIDE FUNDAMENTAL PANEL\n","# ============================================================\n","\n","fundamental_panel = (\n","    pit_fundamentals\n","    .pivot_table(\n","        index=[\"date\", \"ticker\"],\n","        columns=\"fundamental\",\n","        values=\"value\",\n","        aggfunc=\"last\"\n","    )\n","    .reset_index()\n",")\n","\n","fundamental_panel.columns.name = None\n","\n","fundamental_panel.head()\n","# ============================================================\n","# CELL 9 — PRICE FACTOR ENGINEERING\n","# ============================================================\n","\n","def calculate_price_features(\n","    prices: pd.DataFrame\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Generate cross-sectional equity features.\n","\n","    Features:\n","        momentum_12_1\n","        momentum_6_1\n","        volatility_252\n","    \"\"\"\n","\n","    records = []\n","\n","    for ticker in prices.columns:\n","\n","        series = prices[ticker].dropna()\n","\n","        if len(series) < CONFIG.min_history_days:\n","            continue\n","\n","        df = pd.DataFrame(index=series.index)\n","\n","        df[\"ticker\"] = ticker\n","        df[\"price\"] = series\n","\n","\n","\n","        df[\"momentum_12_1\"] = (\n","            series.shift(21)\n","            / series.shift(252)\n","            - 1\n","        )\n","\n","\n","        df[\"momentum_6_1\"] = (\n","            series.shift(21)\n","            / series.shift(126)\n","            - 1\n","        )\n","\n","\n","\n","        daily_returns = series.pct_change()\n","\n","        df[\"volatility_252\"] = (\n","            daily_returns\n","            .rolling(252)\n","            .std()\n","            * np.sqrt(252)\n","        )\n","\n","\n","\n","        df[\"return_21d\"] = (\n","            series / series.shift(21) - 1\n","        )\n","\n","        records.append(df.reset_index())\n","\n","    if not records:\n","        raise RuntimeError(\n","            \"Unable to create price features.\"\n","        )\n","\n","    output = pd.concat(\n","        records,\n","        ignore_index=True\n","    )\n","\n","    output.rename(\n","        columns={\"Date\": \"date\"},\n","        inplace=True\n","    )\n","\n","    return output\n","\n","\n","price_features = calculate_price_features(prices)\n","\n","price_features.head()\n","# ============================================================\n","# CELL 10 — COMBINE DATASETS\n","# ============================================================\n","\n","\n","price_features[\"date\"] = pd.to_datetime(\n","    price_features[\"date\"]\n",")\n","\n","fundamental_panel[\"date\"] = pd.to_datetime(\n","    fundamental_panel[\"date\"]\n",")\n","\n","dataset = price_features.merge(\n","    fundamental_panel,\n","    on=[\"date\", \"ticker\"],\n","    how=\"left\"\n",")\n","\n","print(dataset.shape)\n","\n","dataset.tail()\n","# ============================================================\n","# CELL 11 — MARKET CAPITALIZATION\n","# ============================================================\n","\n","def add_market_cap(\n","    df: pd.DataFrame\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Estimate market capitalization.\n","\n","    SEC shares outstanding are point-in-time fundamentals.\n","    Prices are observed on the rebalance date.\n","\n","    market_cap = price × shares_outstanding\n","    \"\"\"\n","\n","    df = df.copy()\n","\n","    if \"shares\" in df.columns:\n","\n","        df[\"market_cap\"] = (\n","            df[\"price\"]\n","            * df[\"shares\"]\n","        )\n","\n","    else:\n","\n","\n","        df[\"market_cap\"] = np.nan\n","\n","    return df\n","\n","\n","dataset = add_market_cap(dataset)\n","\n","dataset[\n","    [\"date\", \"ticker\", \"price\", \"shares\", \"market_cap\"]\n","].tail()\n","# ============================================================\n","# CELL 12 — FUNDAMENTAL FEATURE ENGINEERING\n","# ============================================================\n","\n","def safe_divide(\n","    numerator: pd.Series,\n","    denominator: pd.Series\n",") -> pd.Series:\n","\n","    denominator = denominator.replace(\n","        0,\n","        np.nan\n","    )\n","\n","    result = numerator / denominator\n","\n","    result = result.replace(\n","        [np.inf, -np.inf],\n","        np.nan\n","    )\n","\n","    return result\n","\n","\n","def engineer_fundamental_features(\n","    df: pd.DataFrame\n",") -> pd.DataFrame:\n","\n","    df = df.copy()\n","\n","\n","    df[\"earnings_yield\"] = safe_divide(\n","        df[\"net_income\"],\n","        df[\"market_cap\"]\n","    )\n","\n","\n","\n","    df[\"book_to_market\"] = safe_divide(\n","        df[\"equity\"],\n","        df[\"market_cap\"]\n","    )\n","\n","\n","\n","    df[\"roe\"] = safe_divide(\n","        df[\"net_income\"],\n","        df[\"equity\"]\n","    )\n","\n","\n","\n","    df[\"roa\"] = safe_divide(\n","        df[\"net_income\"],\n","        df[\"assets\"]\n","    )\n","\n","\n","\n","    df[\"operating_margin\"] = safe_divide(\n","        df[\"operating_income\"],\n","        df[\"revenue\"]\n","    )\n","\n","\n","    df = df.sort_values(\n","        [\"ticker\", \"date\"]\n","    )\n","\n","    df[\"revenue_growth\"] = (\n","        df.groupby(\"ticker\")[\"revenue\"]\n","        .pct_change(4)\n","    )\n","\n","    return df\n","\n","\n","dataset = engineer_fundamental_features(\n","    dataset\n",")\n","\n","dataset[\n","    [\n","        \"date\",\n","        \"ticker\",\n","        \"earnings_yield\",\n","        \"book_to_market\",\n","        \"roe\",\n","        \"roa\",\n","        \"operating_margin\",\n","        \"revenue_growth\"\n","    ]\n","].tail()\n","# ============================================================\n","# CELL 13 — ROBUST DATA CLEANING\n","# ============================================================\n","\n","FACTOR_COLUMNS = [\n","    \"momentum_12_1\",\n","    \"earnings_yield\",\n","    \"book_to_market\",\n","    \"roe\",\n","    \"revenue_growth\",\n","    \"volatility_252\",\n","    \"market_cap\"\n","]\n","\n","\n","def winsorize_cross_section(\n","    series: pd.Series,\n","    lower: float = 0.01,\n","    upper: float = 0.99\n",") -> pd.Series:\n","\n","    if series.dropna().empty:\n","        return series\n","\n","    low = series.quantile(lower)\n","    high = series.quantile(upper)\n","\n","    return series.clip(\n","        lower=low,\n","        upper=high\n","    )\n","\n","\n","def clean_features(\n","    df: pd.DataFrame\n",") -> pd.DataFrame:\n","\n","    df = df.copy()\n","\n","    for column in FACTOR_COLUMNS:\n","\n","        if column not in df.columns:\n","            continue\n","\n","        df[column] = (\n","            df.groupby(\"date\")[column]\n","            .transform(\n","                lambda x: winsorize_cross_section(\n","                    x,\n","                    CONFIG.winsor_lower,\n","                    CONFIG.winsor_upper\n","                )\n","            )\n","        )\n","\n","    return df\n","\n","\n","dataset = clean_features(dataset)\n","\n","print(\n","    dataset[\n","        FACTOR_COLUMNS\n","    ].isna().mean().sort_values()\n",")\n","# ============================================================\n","# CELL 14 — CROSS-SECTIONAL STANDARDIZATION\n","# ============================================================\n","\n","def cross_sectional_zscore(\n","    series: pd.Series\n",") -> pd.Series:\n","\n","    std = series.std()\n","\n","    if pd.isna(std) or std == 0:\n","        return pd.Series(\n","            0.0,\n","            index=series.index\n","        )\n","\n","    return (\n","        series - series.mean()\n","    ) / std\n","\n","\n","def add_factor_scores(\n","    df: pd.DataFrame\n",") -> pd.DataFrame:\n","\n","    df = df.copy()\n","\n","\n","    df[\"factor_momentum\"] = (\n","        df.groupby(\"date\")[\"momentum_12_1\"]\n","        .transform(cross_sectional_zscore)\n","    )\n","\n","\n","    value_raw = (\n","        df[\"earnings_yield\"].fillna(0)\n","        + df[\"book_to_market\"].fillna(0)\n","    )\n","\n","    df[\"factor_value\"] = (\n","        value_raw.groupby(df[\"date\"])\n","        .transform(cross_sectional_zscore)\n","    )\n","\n","\n","    quality_raw = (\n","        df[\"roe\"].fillna(0)\n","        + df[\"roa\"].fillna(0)\n","        + df[\"operating_margin\"].fillna(0)\n","    )\n","\n","    df[\"factor_quality\"] = (\n","        quality_raw.groupby(df[\"date\"])\n","        .transform(cross_sectional_zscore)\n","    )\n","\n","\n","    df[\"factor_growth\"] = (\n","        df.groupby(\"date\")[\"revenue_growth\"]\n","        .transform(cross_sectional_zscore)\n","    )\n","\n","\n","    df[\"factor_low_vol\"] = (\n","        -df.groupby(\"date\")[\"volatility_252\"]\n","        .transform(cross_sectional_zscore)\n","    )\n","\n","\n","    df[\"log_market_cap\"] = np.log(\n","        df[\"market_cap\"].where(\n","            df[\"market_cap\"] > 0\n","        )\n","    )\n","\n","    df[\"factor_size\"] = (\n","        -df.groupby(\"date\")[\"log_market_cap\"]\n","        .transform(cross_sectional_zscore)\n","    )\n","\n","    return df\n","\n","\n","dataset = add_factor_scores(dataset)\n","\n","factor_columns = [\n","    \"factor_momentum\",\n","    \"factor_value\",\n","    \"factor_quality\",\n","    \"factor_growth\",\n","    \"factor_low_vol\",\n","    \"factor_size\"\n","]\n","\n","dataset[\n","    [\"date\", \"ticker\"] + factor_columns\n","].tail()\n","# ============================================================\n","# CELL 15 — COMPOSITE ALPHA MODEL\n","# ============================================================\n","\n","def calculate_composite_score(\n","    df: pd.DataFrame,\n","    weights: Dict[str, float]\n",") -> pd.DataFrame:\n","\n","    df = df.copy()\n","\n","    df[\"alpha_score\"] = 0.0\n","\n","    for factor_name, weight in weights.items():\n","\n","        column = f\"factor_{factor_name}\"\n","\n","        if column not in df.columns:\n","            raise KeyError(\n","                f\"Missing factor column: {column}\"\n","            )\n","\n","        df[\"alpha_score\"] += (\n","            weight * df[column].fillna(0)\n","        )\n","\n","\n","    df[\"alpha_percentile\"] = (\n","        df.groupby(\"date\")[\"alpha_score\"]\n","        .rank(pct=True)\n","    )\n","\n","\n","    df[\"alpha_rank\"] = (\n","        df.groupby(\"date\")[\"alpha_score\"]\n","        .rank(\n","            ascending=False,\n","            method=\"first\"\n","        )\n","    )\n","\n","    return df\n","\n","\n","dataset = calculate_composite_score(\n","    dataset,\n","    FACTOR_WEIGHTS\n",")\n","\n","dataset[\n","    [\n","        \"date\",\n","        \"ticker\",\n","        \"alpha_score\",\n","        \"alpha_percentile\",\n","        \"alpha_rank\"\n","    ]\n","].tail(20)\n","\n","\n","# ============================================================\n","# CELL 16 — FORWARD RETURN CALCULATION\n","# ============================================================\n","\n","def calculate_forward_returns(\n","    prices: pd.DataFrame,\n","    horizon: int = 21\n",") -> pd.DataFrame:\n","\n","    forward_returns = (\n","        prices\n","        .shift(-horizon)\n","        / prices\n","        - 1\n","    )\n","\n","    output = (\n","        forward_returns\n","        .stack()\n","        .rename(\"forward_return\")\n","        .reset_index()\n","    )\n","\n","    output.columns = [\n","        \"date\",\n","        \"ticker\",\n","        \"forward_return\"\n","    ]\n","\n","    return output\n","\n","\n","forward_returns = calculate_forward_returns(\n","    prices,\n","    horizon=21\n",")\n","\n","dataset = dataset.merge(\n","    forward_returns,\n","    on=[\"date\", \"ticker\"],\n","    how=\"left\"\n",")\n","\n","dataset.tail()\n","\n","\n","\n","# ============================================================\n","# CELL 17 — FACTOR INFORMATION COEFFICIENT\n","# ============================================================\n","\n","def calculate_daily_ic(\n","    df: pd.DataFrame,\n","    factor: str,\n","    target: str = \"forward_return\"\n",") -> pd.Series:\n","\n","    def daily_spearman(group):\n","\n","        valid = group[\n","            [factor, target]\n","        ].dropna()\n","\n","        if len(valid) < 5:\n","            return np.nan\n","\n","        return spearmanr(\n","            valid[factor],\n","            valid[target]\n","        ).statistic\n","\n","    return (\n","        df.groupby(\"date\")\n","        .apply(\n","            daily_spearman,\n","            include_groups=False\n","        )\n","    )\n","\n","\n","ic_series = calculate_daily_ic(\n","    dataset,\n","    \"alpha_score\"\n",")\n","\n","ic_mean = ic_series.mean()\n","ic_std = ic_series.std()\n","\n","icir = (\n","    ic_mean / ic_std\n","    if ic_std > 0\n","    else np.nan\n",")\n","\n","print(f\"Mean IC : {ic_mean:.4f}\")\n","print(f\"ICIR    : {icir:.4f}\")\n","\n","# ============================================================\n","# CELL 18 — PORTFOLIO CONSTRUCTION\n","# ============================================================\n","\n","def construct_long_only_portfolio(\n","    df: pd.DataFrame,\n","    top_quantile: float = 0.20\n",") -> pd.DataFrame:\n","    \"\"\"\n","    Equal-weight the highest-ranked securities.\n","\n","    Portfolio weights are calculated cross-sectionally\n","    at each rebalance date.\n","    \"\"\"\n","\n","    df = df.copy()\n","\n","    df[\"selected\"] = (\n","        df[\"alpha_percentile\"]\n","        >= 1 - top_quantile\n","    )\n","\n","    df[\"weight\"] = 0.0\n","\n","    for date, group in df.groupby(\"date\"):\n","\n","        selected = group[\"selected\"]\n","\n","        count = selected.sum()\n","\n","        if count > 0:\n","\n","            df.loc[\n","                group.index,\n","                \"weight\"\n","            ] = np.where(\n","                selected,\n","                1.0 / count,\n","                0.0\n","            )\n","\n","    return df\n","\n","\n","portfolio = construct_long_only_portfolio(\n","    dataset,\n","    CONFIG.top_quantile\n",")\n","\n","portfolio[\n","    [\n","        \"date\",\n","        \"ticker\",\n","        \"alpha_score\",\n","        \"selected\",\n","        \"weight\"\n","    ]\n","].tail(20)\n","\n","# ============================================================\n","# CELL 19 — PORTFOLIO BACKTEST ENGINE\n","# ============================================================\n","\n","def backtest_portfolio(\n","    portfolio: pd.DataFrame,\n","    prices: pd.DataFrame,\n","    transaction_cost_bps: float = 10\n",") -> pd.DataFrame:\n","\n","    weights = (\n","        portfolio\n","        .pivot_table(\n","            index=\"date\",\n","            columns=\"ticker\",\n","            values=\"weight\",\n","            aggfunc=\"last\"\n","        )\n","        .fillna(0)\n","    )\n","\n","\n","    weights = (\n","        weights\n","        .reindex(prices.index)\n","        .ffill()\n","        .fillna(0)\n","    )\n","\n","    returns = prices.pct_change()\n","\n","\n","    lagged_weights = weights.shift(1).fillna(0)\n","\n","    gross_returns = (\n","        lagged_weights\n","        * returns\n","    ).sum(axis=1)\n","\n","\n","    turnover = (\n","        weights.diff()\n","        .abs()\n","        .sum(axis=1)\n","        .fillna(0)\n","    )\n","\n","\n","    transaction_cost = (\n","        turnover\n","        * transaction_cost_bps\n","        / 10000\n","    )\n","\n","    net_returns = (\n","        gross_returns\n","        - transaction_cost\n","    )\n","\n","    result = pd.DataFrame({\n","        \"gross_return\": gross_returns,\n","        \"transaction_cost\": transaction_cost,\n","        \"net_return\": net_returns,\n","        \"turnover\": turnover\n","    })\n","\n","    result[\"nav\"] = (\n","        1 + result[\"net_return\"]\n","    ).cumprod()\n","\n","    result[\"benchmark\"] = (\n","        1 + returns.mean(axis=1).fillna(0)\n","    ).cumprod()\n","\n","    return result\n","\n","\n","backtest = backtest_portfolio(\n","    portfolio,\n","    prices,\n","    CONFIG.transaction_cost_bps\n",")\n","\n","backtest.tail()\n","\n","# ============================================================\n","# CELL 20 — PERFORMANCE METRICS\n","# ============================================================\n","\n","def performance_metrics(\n","    returns: pd.Series\n",") -> pd.Series:\n","\n","    returns = returns.dropna()\n","\n","    if len(returns) < 2:\n","        return pd.Series(dtype=float)\n","\n","    periods = 252\n","\n","    total_return = (\n","        (1 + returns).prod() - 1\n","    )\n","\n","    years = len(returns) / periods\n","\n","    cagr = (\n","        (1 + total_return) ** (1 / years) - 1\n","        if years > 0\n","        else np.nan\n","    )\n","\n","    annual_vol = (\n","        returns.std() * np.sqrt(periods)\n","    )\n","\n","    sharpe = (\n","        returns.mean() / returns.std()\n","        * np.sqrt(periods)\n","        if returns.std() > 0\n","        else np.nan\n","    )\n","\n","    downside = returns[\n","        returns < 0\n","    ].std() * np.sqrt(periods)\n","\n","    sortino = (\n","        returns.mean() * periods\n","        / downside\n","        if downside > 0\n","        else np.nan\n","    )\n","\n","    wealth = (\n","        1 + returns\n","    ).cumprod()\n","\n","    running_max = wealth.cummax()\n","\n","    drawdown = (\n","        wealth / running_max - 1\n","    )\n","\n","    max_drawdown = drawdown.min()\n","\n","    calmar = (\n","        cagr / abs(max_drawdown)\n","        if max_drawdown != 0\n","        else np.nan\n","    )\n","\n","    return pd.Series({\n","        \"Total Return\": total_return,\n","        \"CAGR\": cagr,\n","        \"Annual Volatility\": annual_vol,\n","        \"Sharpe Ratio\": sharpe,\n","        \"Sortino Ratio\": sortino,\n","        \"Maximum Drawdown\": max_drawdown,\n","        \"Calmar Ratio\": calmar,\n","        \"Average Daily Turnover\": returns.index.to_series().map(\n","            backtest[\"turnover\"]\n","        ).mean()\n","    })\n","\n","\n","metrics = performance_metrics(\n","    backtest[\"net_return\"]\n",")\n","\n","metrics\n","\n","# ============================================================\n","# CELL 21 — PERFORMANCE DASHBOARD\n","# ============================================================\n","\n","plt.style.use(\"seaborn-v0_8-whitegrid\")\n","\n","fig, axes = plt.subplots(\n","    3,\n","    1,\n","    figsize=(14, 14),\n","    sharex=True\n",")\n","\n","\n","axes[0].plot(\n","    backtest.index,\n","    backtest[\"nav\"],\n","    label=\"Multi-Factor Strategy\",\n","    linewidth=2\n",")\n","\n","axes[0].plot(\n","    backtest.index,\n","    backtest[\"benchmark\"],\n","    label=\"Equal-Weight Benchmark\",\n","    linewidth=1.5\n",")\n","\n","axes[0].set_title(\n","    \"Multi-Factor Equity Alpha — Cumulative Performance\",\n","    fontsize=15,\n","    fontweight=\"bold\"\n",")\n","\n","axes[0].set_ylabel(\"Growth of $1\")\n","axes[0].legend()\n","\n","\n","wealth = backtest[\"nav\"]\n","\n","drawdown = (\n","    wealth / wealth.cummax() - 1\n",")\n","\n","axes[1].fill_between(\n","    drawdow